{
  "name": "tracker",
  "private": true,
  "version": "3.0.0",
  "description": "Aurora's browser tracking script",
  "type": "module",
  "scripts": {
    "build": "esbuild src/aurora.js --bundle --minify --format=iife --target=es2018 --outfile=../../apps/web/public/tracker.js",
    "dev": "esbuild src/aurora.js --bundle --format=iife --target=es2018 --outfile=../../apps/web/public/tracker.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
