# Postgres connection string used by Drizzle (runtime + migrations).
DATABASE_URL=postgres://root:password@localhost:5434/aurora

# Secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Single sign-on through an OpenID Connect provider. Leave OIDC_ISSUER unset to
# keep SSO off. See "Single sign-on" in the README.
# OIDC_ISSUER=https://id.example.com/realms/acme
# OIDC_CLIENT_ID=aurora
# OIDC_CLIENT_SECRET=
# One per domain the instance is served on, comma-separated.
# OIDC_REDIRECT_URI=http://localhost:5173/auth/oidc/callback
# OIDC_PROVIDER_NAME=Keycloak
# OIDC_ALLOWED_DOMAINS=example.com

# Close /signup, so new accounts come only through SSO.
# AURORA_DISABLE_PASSWORD_SIGNUP=true

# Make SSO the only way in (needs OIDC_ISSUER). Connect accounts first.
# AURORA_DISABLE_PASSWORD_LOGIN=true

# Sign out of Aurora only, leaving the session at the provider.
# OIDC_PROVIDER_LOGOUT=false
