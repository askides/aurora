{
  "name": "aurora",
  "private": true,
  "version": "3.0.0",
  "description": "Aurora - Open, Cookie-Free Website Analytics",
  "author": "Renato Pozzi <renato.pozzi.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsrennyman/aurora.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,css}\"",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:reset": "pnpm --filter web db:reset"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
