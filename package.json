{
  "name": "aurora",
  "private": true,
  "version": "3.0.0",
  "description": "Aurora - Open, Cookie-Free Website Analytics",
  "author": "Renato Pozzi <renato.pozzi.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsrennyman/aurora.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:reset": "pnpm --filter web db:reset"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  }
}
